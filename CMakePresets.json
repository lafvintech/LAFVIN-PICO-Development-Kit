{
  "version": 2,
  "configurePresets": [
    {
      "name": "pico",
      "displayName": "Pico",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/pico",
      "cacheVariables": {
        "PICO_BOARD": "pico",
        "PICO_OPTIMIZED_DEBUG": "1",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "pico-w",
      "displayName": "Pico W / Pico WH",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/pico_w",
      "cacheVariables": {
        "PICO_BOARD": "pico_w",
        "PICO_OPTIMIZED_DEBUG": "1",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "pico2-w",
      "displayName": "Pico 2 W",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/pico2_w",
      "cacheVariables": {
        "PICO_BOARD": "pico2_w",
        "PICO_OPTIMIZED_DEBUG": "1",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "pico",
      "configurePreset": "pico"
    },
    {
      "name": "pico-w",
      "configurePreset": "pico-w"
    },
    {
      "name": "pico2-w",
      "configurePreset": "pico2-w"
    }
  ]
}
